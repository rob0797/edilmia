<IfModule mod_mime.c>
  AddType font/ttf .ttf
  AddType font/woff2 .woff2
</IfModule>

RewriteEngine On
RewriteBase /

# Redirect non-www → www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

# Blocca accesso diretto ai template interni
RewriteRule ^pages/ - [F,L]

# Servi file e cartelle esistenti (asset, favicon, ecc.) senza riscrittura
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect 301: /?page=slug → /slug (elimina URL duplicati legacy)
RewriteCond %{QUERY_STRING} ^page=chi-siamo$
RewriteRule ^$ /chi-siamo? [R=301,L]

RewriteCond %{QUERY_STRING} ^page=servizi$
RewriteRule ^$ /servizi? [R=301,L]

RewriteCond %{QUERY_STRING} ^page=progetti$
RewriteRule ^$ /progetti? [R=301,L]

RewriteCond %{QUERY_STRING} ^page=contatti$
RewriteRule ^$ /contatti? [R=301,L]

RewriteCond %{QUERY_STRING} ^page=policy$
RewriteRule ^$ /policy? [R=301,L]

RewriteCond %{QUERY_STRING} ^page=home$
RewriteRule ^$ /? [R=301,L]

# Route pulite → index.php (unico entry point)
RewriteRule ^chi-siamo/?$ index.php?page=chi-siamo [L,QSA]
RewriteRule ^servizi/?$ index.php?page=servizi [L,QSA]
RewriteRule ^progetti/?$ index.php?page=progetti [L,QSA]
RewriteRule ^contatti/?$ index.php?page=contatti [L,QSA]
RewriteRule ^policy/?$ index.php?page=policy [L,QSA]

# Home page
RewriteRule ^$ index.php [L]

# Caching headers per asset statici
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresDefault                        "access plus 7 days"
</IfModule>
